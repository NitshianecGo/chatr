rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Эти правила нужно вставить в Firebase Console →
// Firestore Database → Rules. Подробности в README.md (Шаг 4).
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Профили пользователей: читать может любой вошедший,
    // менять — только владелец профиля
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Чаты доступны только их участникам
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isParticipant(chatId);
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if isParticipant(chatId);
        allow write: if isSignedIn() && request.auth.uid == uid && isParticipant(chatId);
      }
    }
  }
}
